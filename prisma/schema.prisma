generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  status         String      @default("pending")

  firstName      String
  lastName       String
  email          String
  phone          String

  address        String
  city           String
  zip            String
  country        String

  shippingMethod String
  shippingPrice  Float

  subtotal       Float
  total          Float

  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  items          OrderItem[]

  cjOrderId      String?
  cjStatus       String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId      String
  productName    String
  productPrice   Float
  quantity       Int
  selectedColor  String?
  selectedSize   String?
}

model Product {
  id            String   @id
  stock         Int      @default(50)
  cjProductId   String?
  cjVariantId   String?
  updatedAt     DateTime @updatedAt

  // Product detail fields (seeded from static data, editable via admin)
  name          String   @default("")
  category      String   @default("")
  categoryLabel String   @default("")
  price         Float    @default(0)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  badge         String?
  images        String[] @default([])
  thumbImage    String   @default("")
  shortDesc     String   @default("")
  description   String   @default("")
  features      String[] @default([])
  colors        String[] @default([])
  sizes         String[] @default([])
  supplier      String   @default("")
  supplierNote  String   @default("")
  active        Boolean  @default(true)
}

model Supplier {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  phone      String?
  country    String   @default("CN")
  productIds String[] @default([])
  active     Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
